// NextGen Mahatech — Prisma schema
//
// Database: PostgreSQL
// Client:   @prisma/client
//
// To migrate against your database:
//   1. Set DATABASE_URL in a `.env` file
//      DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nextgen_mahatech?schema=public"
//   2. Run `npx prisma migrate dev --name init`
//   3. Run `npx prisma generate`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Services — rendered on the site
// ---------------------------------------------------------------------------
model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  tagline         String?
  description     String
  longDescription String?  @map("long_description")
  icon            String?
  tone            String?
  features        String[] @default([])
  deliverables    String[] @default([])
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("services")
}

// ---------------------------------------------------------------------------
// Portfolio — admin-managed showcase items rendered on /portfolio
// ---------------------------------------------------------------------------
model Portfolio {
  id          String   @id @default(cuid())
  title       String
  category    String?
  description String
  image       String?
  link        String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("portfolio_items")
}

// ---------------------------------------------------------------------------
// AMS features — admin-managed cards rendered on /solutions/ams
// ---------------------------------------------------------------------------
model AmsFeature {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  tone        String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("ams_features")
}

// ---------------------------------------------------------------------------
// Testimonials — client stories
// ---------------------------------------------------------------------------
model Testimonial {
  id      String   @id @default(cuid())
  client  String
  role    String?
  quote   String
  rating  Int      @default(5)
  active  Boolean  @default(true)
  sortOrder Int    @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active, sortOrder])
  @@map("testimonials")
}

// ---------------------------------------------------------------------------
// Team members — admin-managed leadership cards rendered on /about
// ---------------------------------------------------------------------------
model TeamMember {
  id              String   @id @default(cuid())
  name            String
  role            String?
  image           String?
  tone            String?
  message         String
  quote           String?
  extendedMessage String?  @map("extended_message")
  vision          String?
  leadership      String?
  closing         String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([active, sortOrder])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Blog / Insights — optional content posts
// ---------------------------------------------------------------------------
model Post {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  excerpt   String?
  content   String
  published Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([published, createdAt])
  @@map("posts")
}
