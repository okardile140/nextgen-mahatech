# Copy this file to `.env` and fill in your real credentials.
# PostgreSQL connection strings for NextGen Mahatech.

# Main URL used by Prisma Client at runtime (queries).
# Use a pooled/direct connection depending on your host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nextgen_mahatech?schema=public"

# Optional — for migrations when using a connection pooler (PgBouncer/Supabase/Neon).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/nextgen_mahatech?schema=public"

# Admin panel (/admin) passcode. Defaults to "admin123" when unset.
NEXT_PUBLIC_ADMIN_KEY="admin123"
